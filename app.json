{
  "expo": {
    "name": "astroinsights",
    "slug": "astroinsights",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "com.googleusercontent.apps.154762470670-n099k64j893h5qr85lrhh85fiutk533e",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "io.astroinsights.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": false,
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to sign in to AstroInsights faster and more securely.",
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you.",
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "v9wttpbfk9.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "n38lu8286q.skadnetwork"
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Google Sign-In",
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.154762470670-n099k64j893h5qr85lrhh85fiutk533e"
            ]
          }
        ]
      }
    },
    "android": {
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "io.astroinsights.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "5b385fcd-cb4c-4770-b433-665e4c0f0cdf"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/5b385fcd-cb4c-4770-b433-665e4c0f0cdf"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.154762470670-n099k64j893h5qr85lrhh85fiutk533e"
        }
      ],
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to sign in to AstroInsights faster and more securely."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification.png",
          "color": "#577CFB"
        }
      ]
    ]
  }
}
