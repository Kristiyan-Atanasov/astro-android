{
  "expo": {
    "name": "Astroinsights",
    "slug": "astroinsights",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "scheme": "com.googleusercontent.apps.154762470670-n099k64j893h5qr85lrhh85fiutk533e",
    "userInterfaceStyle": "automatic",
    "android": {
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "io.astroinsights.app",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0A0E1A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "e5729bd2-6e16-4292-aa16-f2e2fad45adc"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/e5729bd2-6e16-4292-aa16-f2e2fad45adc"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use biometrics to sign in to AstroInsights faster and more securely."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification.png",
          "color": "#577CFB"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AstroInsights to access your photos so you can set a profile picture."
        }
      ]
    ],
    "owner": "astroinsightseood"
  }
}
